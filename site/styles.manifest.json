{
  "version": 1,
  "note": "Registry of predefined styles. The editor builds every picker from this file. Each class must exist in site/scss/_library.scss (compiled to site/css/site.css). 'applies' lists the item types a group is offered for ('page' = page settings); 'exclusive' means only one class from the group at a time. 'theme' defines the global settings: the colour palette (token -> --color-<token>; 'dark' marks colours that change in dark mode) and options that set one CSS variable from a fixed list of choices.",
  "groups": [
    {
      "id": "section-space",
      "label": "Section spacing",
      "applies": ["section"],
      "exclusive": true,
      "classes": [
        { "class": "space-s", "label": "Small" },
        { "class": "space-none", "label": "None" },
        { "class": "full-bleed", "label": "Full bleed" }
      ]
    },
    {
      "id": "columns",
      "label": "Columns",
      "applies": ["row"],
      "exclusive": true,
      "classes": [
        { "class": "cols-2", "label": "2 columns" },
        { "class": "cols-3", "label": "3 columns" },
        { "class": "cols-4", "label": "4 columns" },
        { "class": "cols-auto", "label": "Auto fit" }
      ]
    },
    {
      "id": "gap",
      "label": "Gap",
      "applies": ["row"],
      "exclusive": true,
      "classes": [
        { "class": "gap-none", "label": "None" },
        { "class": "gap-l", "label": "Large" }
      ]
    },
    {
      "id": "align",
      "label": "Vertical align",
      "applies": ["row"],
      "exclusive": true,
      "classes": [
        { "class": "align-center", "label": "Center" },
        { "class": "align-end", "label": "Bottom" }
      ]
    },
    {
      "id": "span",
      "label": "Column span",
      "applies": ["col"],
      "exclusive": true,
      "classes": [
        { "class": "span-2", "label": "Span 2" },
        { "class": "span-full", "label": "Full row" }
      ]
    },
    {
      "id": "width",
      "label": "Width",
      "applies": ["row", "heading", "text", "image", "video"],
      "exclusive": true,
      "classes": [
        { "class": "w-1-3", "label": "1/3" },
        { "class": "w-1-2", "label": "1/2" },
        { "class": "w-2-3", "label": "2/3" }
      ]
    },
    {
      "id": "ratio",
      "label": "Aspect ratio",
      "applies": ["image", "video"],
      "exclusive": true,
      "classes": [
        { "class": "ratio-1-1", "label": "1:1" },
        { "class": "ratio-4-3", "label": "4:3" },
        { "class": "ratio-3-4", "label": "3:4" },
        { "class": "ratio-16-9", "label": "16:9" },
        { "class": "ratio-21-9", "label": "21:9" }
      ]
    },
    {
      "id": "fit",
      "label": "Fit",
      "applies": ["image", "video"],
      "exclusive": true,
      "classes": [
        { "class": "fit-cover", "label": "Fill (cover)" },
        { "class": "fit-contain", "label": "Fit (contain)" }
      ]
    },
    {
      "id": "type",
      "label": "Text style",
      "applies": ["heading", "text"],
      "exclusive": true,
      "classes": [
        { "class": "type-display", "label": "Display" },
        { "class": "type-h1", "label": "Heading 1" },
        { "class": "type-h2", "label": "Heading 2" },
        { "class": "type-h3", "label": "Heading 3" },
        { "class": "type-lead", "label": "Lead" },
        { "class": "type-small", "label": "Small" }
      ]
    },
    {
      "id": "text-modifiers",
      "label": "Text options",
      "applies": ["heading", "text"],
      "exclusive": false,
      "classes": [
        { "class": "type-muted", "label": "Muted" },
        { "class": "text-center", "label": "Centered" },
        { "class": "text-right", "label": "Right" },
        { "class": "text-upper", "label": "Uppercase" },
        { "class": "measure", "label": "Readable width" }
      ]
    },
    {
      "id": "position",
      "label": "Position",
      "applies": ["section", "row", "col", "heading", "text", "image", "video"],
      "exclusive": true,
      "classes": [
        { "class": "pos-sticky", "label": "Sticky" },
        { "class": "pos-fixed-top", "label": "Fixed top" }
      ]
    },
    {
      "id": "animation",
      "label": "Animation",
      "applies": ["section", "row", "col", "heading", "text", "image", "video"],
      "exclusive": true,
      "classes": [
        { "class": "anim-fade-in", "label": "Fade in" },
        { "class": "anim-slide-up", "label": "Slide up" },
        { "class": "anim-slide-left", "label": "Slide in from right" },
        { "class": "anim-slide-right", "label": "Slide in from left" },
        { "class": "anim-zoom-in", "label": "Zoom in" }
      ]
    },
    {
      "id": "delay",
      "label": "Animation delay",
      "applies": ["section", "row", "col", "heading", "text", "image", "video"],
      "exclusive": true,
      "classes": [
        { "class": "delay-1", "label": "Short" },
        { "class": "delay-2", "label": "Medium" },
        { "class": "delay-3", "label": "Long" }
      ]
    },
    {
      "id": "page-width",
      "label": "Page width",
      "applies": ["page"],
      "exclusive": true,
      "classes": [
        { "class": "page-narrow", "label": "Narrow" },
        { "class": "page-wide", "label": "Wide" },
        { "class": "page-full", "label": "Full width" }
      ]
    },
    {
      "id": "page-spacing",
      "label": "Section spacing",
      "applies": ["page"],
      "exclusive": true,
      "classes": [
        { "class": "page-compact", "label": "Compact" },
        { "class": "page-airy", "label": "Airy" }
      ]
    }
  ],
  "theme": {
    "palette": [
      { "token": "bg", "label": "Background", "light": "#f6f5f2", "dark": "#111111" },
      { "token": "text", "label": "Text", "light": "#161616", "dark": "#ececec" },
      { "token": "muted", "label": "Muted text", "light": "#6b6b6b", "dark": "#9a9a9a" },
      { "token": "accent", "label": "Accent", "light": "#2f5bff" },
      { "token": "light", "label": "Light", "light": "#f6f5f2" },
      { "token": "dark", "label": "Dark", "light": "#161616" }
    ],
    "options": [
      {
        "var": "anim-duration", "label": "Animation speed", "default": "700ms",
        "choices": [
          { "value": "400ms", "label": "Fast" },
          { "value": "700ms", "label": "Normal" },
          { "value": "1100ms", "label": "Slow" }
        ]
      },
      {
        "var": "radius-media", "label": "Image corners", "default": "0px",
        "choices": [
          { "value": "0px", "label": "Square" },
          { "value": "4px", "label": "Small" },
          { "value": "12px", "label": "Medium" },
          { "value": "28px", "label": "Large" }
        ]
      },
      {
        "var": "radius-button", "label": "Button corners", "default": "999px",
        "choices": [
          { "value": "0px", "label": "Square" },
          { "value": "6px", "label": "Small" },
          { "value": "999px", "label": "Round" }
        ]
      },
      {
        "var": "radius-input", "label": "Form field corners", "default": "6px",
        "choices": [
          { "value": "0px", "label": "Square" },
          { "value": "6px", "label": "Small" },
          { "value": "12px", "label": "Medium" }
        ]
      }
    ]
  }
}
