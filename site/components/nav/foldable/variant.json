	"description": "Always behind the menu button, also on desktop. Opens as a drop-down panel or over the whole screen.",
	"version": "1.0.0",
	"class": "nav--foldable",
	"scss": "_foldable.scss",
	"needs": [],
	"options": [
		{
			"id": "nav-panel",
			"label": "Menu panel",
			"exclusive": true,
			"default": "nav--panel-drop",
